# Operator configuration (non-secrets).
# Mount at /config/config.yaml in production (Azure Files).
# Authenticate with DefaultAzureCredential (managed identity or `az login`).
# Set SNYK_TOKEN in the environment (secret).
# When scopeMapping.azure-repos is non-empty, also set ADO_PAT with Code (Read)
# access to ado.organization and every mapped project.

# Required only when scopeMapping.azure-repos is non-empty.
# ado:
#   organization: contoso
  # host: dev.azure.com

# messaging.transport defaults to serviceBus, which remains recommended.
# messaging:
#   transport: serviceBus

# serviceBus:
#   fullyQualifiedNamespace: mynamespace.servicebus.windows.net
#   queueName: repo-sync-events
  # receiveMaxWaitSeconds: 5   # optional; max seconds per receive poll (does not stop the worker)

syncState:
  storageAccountEndpoint: https://myaccount.table.core.windows.net
  # tableName: SnykSyncState

# Kafka transport only. Queue is in the same storage account as the table
# (host .table. becomes .queue.). Pre-provision the queue and poison queue.
# storageQueue:
#   queueName: repo-sync-followups
#   # poisonQueueName: repo-sync-followups-poison
#
# The event connector sends GitHub JSON to private POST /github-events.
# Do not expose this unauthenticated endpoint publicly.
http:
  bindHost: 0.0.0.0
  port: 8080
  maxRequestBodyBytes: 1048576
  processingConcurrency: 1

# Optional: map ADO project names, GitHub org logins, or extracted property
# values to Snyk organization ids. Resolution stops at the first success:
# static row, org-name match, snykOrgId stored on the repository row, then
# defaultSnykOrgId. With no default, the worker logs a warning and skips Snyk.
scopeMapping:
  defaultSnykOrgId: "00000000-0000-0000-0000-000000000000"
#   snykGroupId: "11111111-2222-3333-4444-555555555555"  # required when matchSnykOrgName.enabled is true
#   azure-repos:
#     - projectName: Contoso-Platform
#       snykOrgId: "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
#       # snykIntegrationId: "bbbbbbbb-..."       # optional
#   propertyExtractors:
#     github:
#       collectionPath: newPropertyValues
#       matchField: property_name
#       matchValue: azure-devops-project
#       valueField: value
#   github-enterprise:
#     entries:
#       - orgName: contoso
#         snykOrgId: "ffffffff-ffff-ffff-ffff-ffffffffffff"
#       - propertyValue: sample-project
#         snykOrgId: "eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"
#     matchSnykOrgName:
#       enabled: true    # compare the candidate to org names in snykGroupId
#       normalize: true  # strip accents and ignore case; punctuation stays significant
#   # A section may also be a bare list. Other GitHub keys: github, github-cloud-app,
#   # github-server-app. At most one GitHub section may set enabled: true.
#   # azure-repos accepts projectName or propertyValue rows. propertyValue requires
#   # propertyExtractors.azure-repos. A GitHub import does not deactivate an ADO target.

# Optional: ignore policy file (YAML or JSON, UTF-8).
# Relative paths resolve from the directory containing this config file.
ignoredRepos:
  path: ignored-repos.yaml
  reconciliationIntervalMinutes: 15

# Optional: Snyk lifecycle sync behaviour (defaults shown).
snyk:
  maxConcurrentPendingImports: 100
  targetRemoval:
    onRename: deactivate              # deactivate | delete
    onDefaultBranchChange: deactivate
    onRepoDelete: deactivate
    onIgnore: deactivate
